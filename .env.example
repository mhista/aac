NEXT_PUBLIC_SITE_URL=https://aaci.ngo
NEXT_PUBLIC_SUPABASE_URL=https://dnlnmxwejbslyonhxxfb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Delivery via ImageKit is OFF until the files are actually uploaded.
#   1. npm run upload:images
#   2. then set this to true
NEXT_PUBLIC_IMAGEKIT_ENABLED=true
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/aac
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Powers the chat assistant and summarises CVs. Without it, CV text is
# still stored and searchable — it just is not read into fields.
GROQ_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="All Against Cancer Initiative <applications@aaci.ngo>"

# Lets the dashboard register campus subdomains with the host itself.
# Vercel → Settings → Tokens, and Settings → General for the project id.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=   # only if the project belongs to a team
